# Public URL of the hosted demo; the footer QR code points here
NEXT_PUBLIC_DEMO_URL=http://localhost:3000

# PayPal sandbox app credentials, server side only. Leave blank to run the pledge flow as a preview.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Sandbox business accounts that receive the live demo's payouts
PAYPAL_PARTNER_A_EMAIL=
PAYPAL_PARTNER_B_EMAIL=

# The backend routes under /api (pledges, donors, events, proofs, ops, tick, webhooks/paypal). All optional while building.
# Blank: the /api routes use mock PayPal, and /run uses the sandbox once the keys above are set, as it always has.
# paypal: everything uses the sandbox, and needs the partner emails. mock: the backend's charges and payouts never reach PayPal, /run's included.
LEVEE_PAYMENTS=
# Supabase: where Levee's state, ledger, audit log and /run's sessions are kept. Run supabase/migrations/*.sql in its SQL editor first.
# From your project's Settings > API. The service-role key is secret: it stays on the server and never goes in a NEXT_PUBLIC_ setting.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Accounts (/signup, /login) use Supabase Auth, and need this too, with the URL and service-role key above. Without it they answer
# "Accounts aren't set up". Only the server uses it, so it isn't a NEXT_PUBLIC_ setting either.
SUPABASE_ANON_KEY=
# Without Supabase: the JSON files the state goes in, which only work on one server. Default to the system's temporary folder.
LEVEE_STORE=
# This site's public address, used for PayPal's return links and the skip links in notices.
LEVEE_BASE_URL=http://localhost:3000
# Bearer tokens, for scripts. A route whose token is blank refuses every script.
LEVEE_OPS_TOKEN=
# People who use /ops: their emails, comma-separated. Make each one a login in Supabase (Authentication > Users > Add user).
LEVEE_OPS_EMAILS=
# One token per partner, as partner-a:token,partner-b:token
LEVEE_PARTNER_TOKENS=
# The scheduler sends this to POST /api/tick every hour
LEVEE_TICK_SECRET=
# Only with LEVEE_PAYMENTS=paypal. From backend/payments: npm run webhook-register, and npm run reserve-setup
PAYPAL_WEBHOOK_ID=
PAYPAL_RESERVE_PLAN_ID=

# Claude, for the agents the website runs: the pledge chat, proof checks, live storm briefs on /live and the donor Q&A on /run.
# The same key as backend/agents/.env. The website reads only this file.
ANTHROPIC_API_KEY=

# Optional. The live demo invoices a sample sponsor, Harbor & Pine Co., for its match. Set a sandbox account email to see the invoice arrive there.
PAYPAL_SPONSOR_EMAIL=
